# ==============================================================================
# Alcancemos Web - Environment Variables Template (V1 WhatsApp Direct Flow)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ACTIVE VARIABLES (V1 Production)
# ------------------------------------------------------------------------------
# Site canonical URL
NEXT_PUBLIC_SITE_URL=https://alcancemos.com

# Official WhatsApp number (Digits only, including country code, e.g., 56912345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=56912345678

# ------------------------------------------------------------------------------
# 2. FUTURE / DISABLED INTEGRATIONS (Not required for V1 Launch)
# ------------------------------------------------------------------------------
# GoHighLevel Integration (Disabled in V1)
# GHL_API_KEY=
# GHL_LOCATION_ID=
# GHL_PIPELINE_ID=
# GHL_STAGE_ID=
# GHL_WEBHOOK_URL=

# Resend Email Service (Disabled in V1)
# RESEND_API_KEY=
# LEAD_NOTIFICATION_EMAIL=hola@alcancemos.com

# Meta Pixel / Conversion API (Optional)
# NEXT_PUBLIC_META_PIXEL_ID=
# META_CONVERSION_API_ACCESS_TOKEN=

# Cloudflare Turnstile (Optional spam protection)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
